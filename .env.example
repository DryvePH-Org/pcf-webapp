# Supabase (project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (or legacy anon) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_TIMEZONE=Asia/Manila
# Set to the final HTTPS origin before enabling notification delivery.
APP_URL=http://localhost:3000

# Database integration tests (tests/rpc.test.ts) are skipped unless this is true.
# Only enable against a disposable/development project.
RUN_DB_TESTS=false

# Resend API key — notification emails only; sign-in does not use email delivery
NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
CRON_SECRET=
# Optional development recipient override
NOTIFY_REDIRECT_TO=

# Google Drive copies of voucher photos (optional). Create them with
# `node scripts/google-drive-auth.mjs client_secret.json` (see docs/GOOGLE_DRIVE.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Alternative to the three GOOGLE_* values above: an Apps Script web app that
# runs as you (works inside a company Workspace). See docs/GOOGLE_DRIVE.md.
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# Google Sheets Apps Script connection (server only)
GOOGLE_SHEETS_SCRIPT_URL=
GOOGLE_SHEETS_SCRIPT_SECRET=

# Custodian receipt extraction (server only)
GROQ_API_KEY=
GROQ_RECEIPT_MODEL=qwen/qwen3.8-27b
