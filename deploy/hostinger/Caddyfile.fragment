# BEGIN pcf
pcf.dryveph.io {
	encode zstd gzip
	request_body {
		max_size 8MB
	}
	# The visitor's real address for PCF's rate limits. Cloudflare's
	# CF-Connecting-IP is trusted only when the connection really comes from
	# Cloudflare (https://www.cloudflare.com/ips); anyone reaching the server
	# directly gets their own connecting address. X-PCF-Client-IP is always
	# overwritten here, so a client cannot supply it.
	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	handle @cloudflare {
		reverse_proxy pcf-web:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-PCF-Client-IP {http.request.header.CF-Connecting-IP}
			header_up -CF-Connecting-IP
		}
	}
	handle {
		reverse_proxy pcf-web:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-PCF-Client-IP {remote_host}
			header_up -CF-Connecting-IP
		}
	}
}
# END pcf
